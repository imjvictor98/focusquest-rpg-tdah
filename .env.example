# =============================================================================
# FocusQuest RPG - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para `.env` para rodar localmente:
#   cp .env.example .env
#
# NUNCA commite o arquivo `.env` no Git!
# Em produção na Netlify, configure estas variáveis em:
#   Site configuration -> Environment variables
# =============================================================================

# Connection string do Neon PostgreSQL (obrigatória)
# Exemplo: postgresql://neondb_owner:SENHA@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"

# Configurações opcionais de WebAuthn / Passkey
# Se não definidas, são inferidas automaticamente a partir do host da requisição.
# Em produção, recomenda-se definir explicitamente o domínio do site:
RP_NAME="FocusQuest RPG"
# RP_ID="focusquest-rpg-tdah.netlify.app"
# RP_ORIGIN="https://focusquest-rpg-tdah.netlify.app"
